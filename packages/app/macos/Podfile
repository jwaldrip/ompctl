# Native Stack uses its JavaScript fallback on macOS because react-native-screens has no AppKit views.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"
react_native_path = ws_dir.relative_path_from(Pathname.new(__dir__)).join(
  'node_modules',
  'react-native-macos'
)

prepare_react_native_project!

target 'ompd-macOS' do
  platform :macos, '14.0'
  use_native_modules!


  use_react_native!(
    :path => react_native_path.to_s,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer, react_native_path.to_s)

    # Every pod target, including the resource bundles React Native's own
    # post-install pass does not visit, builds against the same floor this
    # target declares above. react-native-svg's RNSVGFilters bundle ships
    # `:osx => '10.14'` in its podspec, and Xcode 27 refuses any deployment
    # target below 12.0 outright: `xcodebuild` failed the whole workspace
    # with "the range of supported deployment target versions is 12.0 to
    # 27.0.x" before compiling a single file of this app.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0'
      end
    end
  end
end
