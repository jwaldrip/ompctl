<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Microsoft.ReactNative Experimental Features">
    <!--
      Required for building a New Architecture project.

      react-native-webview 15.0.0+ ships a Fabric-based Windows implementation.
      react-native-view-shot has no New Architecture Windows implementation in
      any published or unreleased version as of this writing (last checked
      react-native-view-shot@5.1.1 and the gre/react-native-view-shot master
      branch); it fails to build here until upstream migrates it.
    -->
    <RnwNewArch>true</RnwNewArch>

    <!--
      Changes compilation to assume use of Microsoft.ReactNative NuGet packages
      instead of building the framework from source. Defaults to true.
    -->
    <UseExperimentalNuget>true</UseExperimentalNuget>

    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
    <!--
      WindowsAppSDK 1.8 (pulled in transitively from the runner image's newer
      WASDK) adds a C#/csproj-only version check whose Error fires against the
      UWP-TargetFramework Microsoft.ReactNative.Managed.csproj that RNW 0.81
      ships. RNW 0.81 never had this check, so disable it rather than retarget
      the framework project.
    -->
    <WindowsAppSDKVerifyCsWinRtVersions>false</WindowsAppSDKVerifyCsWinRtVersions>
    <RunCodegenWindows>false</RunCodegenWindows>
    <ReactExperimentalFeaturesSet>true</ReactExperimentalFeaturesSet>
  </PropertyGroup>

  <!-- When using NuGet packages, prevent legacy community modules from pulling in Microsoft.ReactNative framework source builds. -->
  <Target Name="RemoveFrameworkProjectReferences" BeforeTargets="ResolveProjectReferences;BeforeResolveReferences;_GetProjectReferenceTargetFrameworkProperties" Condition="'$(UseExperimentalNuget)'=='true'">
    <ItemGroup>
      <ProjectReference Remove="@(ProjectReference)" Condition="'%(FileName)' == 'Microsoft.ReactNative'" />
    </ItemGroup>
  </Target>

</Project>
