{
  "name": "@ompd/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "windows": "react-native run-windows",
    "macos": "react-native run-macos",
    "web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --preload ./test/preload-react.ts test/",
    "check": "bun ../../scripts/check-types.ts tsconfig.json tsconfig.test.json",
    "test:ios:sim": "bash ./scripts/ios-sim-test.sh",
    "test:android:unit": "bash ./scripts/android-unit-test.sh",
    "build:ios:archive": "bash ./scripts/ios-archive.sh",
    "build:android:aab": "bash ./scripts/android-aab.sh",
    "upload:testflight": "bash ./scripts/upload-testflight.sh",
    "upload:play-internal": "bash ./scripts/upload-play-internal.sh",
    "test:android:instrumentation": "bash ./scripts/android-instrumentation-test.sh",
    "build:macos:archive": "bash ./scripts/macos-archive.sh",
    "build:windows:msix": "bash ./scripts/windows-msix.sh"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-native-fontawesome": "1.0.0",
    "@ompd/core": "workspace:*",
    "@ompd/tunnel": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-navigation/elements": "2.9.38",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.81.6",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-macos": "0.81.9",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "5.9.0",
    "react-native-screens": "4.24.0",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "4.0.3",
    "react-native-vision-camera": "4.7.3",
    "react-native-web": "0.21.2",
    "react-native-webview": "15.0.0",
    "react-native-windows": "0.81.30"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1"
  }
}
