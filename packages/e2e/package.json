{
  "name": "@ompd/e2e",
  "private": true,
  "scripts": {
    "test:web": "E2E_CLIENT=web cucumber-js",
    "test:ios": "E2E_CLIENT=ios cucumber-js",
    "test:ios:device": "E2E_CLIENT=ios DETOX_CONFIGURATION=ios.device.debug cucumber-js",
    "test:android": "E2E_CLIENT=android cucumber-js",
    "test:android:device": "E2E_CLIENT=android DETOX_ADB_NAME=${DETOX_ADB_NAME:-34241FDH2004KR} DETOX_CONFIGURATION=android.attached.debug cucumber-js",
    "check": "bun ../../scripts/check-types.ts tsconfig.json",
    "build:android": "detox build --configuration android.attached.debug"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/node": "^22.10.0",
    "detox": "^20.28.0",
    "playwright": "^1.50.0",
    "tsx": "4.23.12"
  }
}
