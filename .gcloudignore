# What `gcloud builds submit` uploads as build context.
#
# This file exists so that set is stated rather than inherited. Without a
# `.gcloudignore`, gcloud falls back to `.gitignore`, and the two files answer
# different questions: `.gitignore` says what should never be committed, this
# says what a build does not need. A pattern that is merely untracked, or that
# happens to match a source directory at some depth, then silently disappears
# from the tree the build sees.
#
# That is not hypothetical. `artifacts/` in `.gitignore` matched
# `packages/app/src/artifacts/`, git kept those files because they were already
# tracked, and every local build worked. Cloud Build received a tree without
# them and failed on `Could not resolve "../artifacts/index.ts"`, twice, with
# the real error visible only inside the Cloud Build log.
#
# So: exclude only what is genuinely reproducible or irrelevant, and never
# exclude anything under a `src/` directory.

# Version control metadata. The build reads no history.
.git
.gitignore
.gitattributes

# Worktrees. Sibling checkouts, never part of this build.
.worktrees
worktrees

# Dependencies. Restored inside the image by `bun install --frozen-lockfile`,
# and uploading them costs gigabytes for bytes the build discards.
node_modules
**/node_modules

# Build output. Regenerated by the image build itself.
dist
**/dist
packages/site/dist

# Native project trees. The hub, web and site images are all server side.
packages/app/android
packages/app/ios
packages/app/windows
packages/app/macos

# Run output, caches and scratch.
packages/e2e/artifacts
.cache
.tmp
.terraform
