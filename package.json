{
  "name": "ompd",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@oh-my-pi/pi-coding-agent": "17.3.4",
      "@oh-my-pi/pi-utils": "17.3.4",
      "@oh-my-pi/pi-tui": "17.3.4",
      "@oh-my-pi/pi-natives": "17.3.4",
      "react": "19.1.4",
      "react-dom": "19.1.4",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "build:cli": "bun build --compile --external omp-legacy-pi-modules --outfile dist/ompd packages/cli/src/main.ts",
    "gen:web-assets": "bun scripts/gen-web-assets.ts",
    "check": "bun run check:tools && bun run check:types",
    "check:evolution": "bun run scripts/check-evolution-lifecycle.ts",
    "check:lan": "bun run scripts/check-lan-roundtrip.ts",
    "check:tools": "biome check . --no-errors-on-unmatched",
    "check:types": "bun run --workspaces --if-present check",
    "test": "bun run --workspaces --if-present test && bun test packages/acp packages/cli packages/core packages/daemon packages/hub packages/tunnel scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@happy-dom/global-registrator": "20.0.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "20.0.0",
    "typescript": "^7.0.2"
  }
}
